# 구글 로그인 클라이언트 ID. 없으면 로그인 화면이 그 사실을 안내한다.
# 체험 모드(npm run demo)에서는 없어도 된다.
VITE_GOOGLE_CLIENT_ID=

# 백엔드 절대 주소. 웹에서는 비워 두고 Vite 프록시(/api)를 탄다.
# Capacitor 로 감쌀 때는 앱이 프록시를 못 타므로 여기에 실제 주소를 넣는다.
VITE_API_BASE_URL=

# 개발 서버가 /api 를 넘길 백엔드 주소.
VITE_API_PROXY_TARGET=http://localhost:8080

# 라우터 종류. 웹은 비워 두고(BrowserRouter), 하이브리드 앱 빌드에서만 hash.
VITE_ROUTER=

# 체험 모드. 1 이면 백엔드 대신 가짜 서버를 쓴다. 보통은 npm run demo 로 켠다.
VITE_DEMO=
