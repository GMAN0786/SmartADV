{
  "name": "scene-talk-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "장면 톡! — 영상에 화면해설(Audio Description)을 만들어 붙이는 접근성 서비스 (웹 · 하이브리드 앱)",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "smoke": "vite build --config smoke/vite.config.mts --logLevel error && node smoke/dist/render.js",
    "demo": "vite --mode demo",
    "build:app": "tsc --noEmit && vite build --mode app",
    "build:app:demo": "tsc --noEmit && vite build --mode app-demo",
    "sync:android": "npm run build:app && cap sync android",
    "sync:android:demo": "npm run build:app:demo && cap sync android",
    "open:android": "cap open android",
    "live:android": "node scripts/live-android.mjs --emulator",
    "live:phone": "node scripts/live-android.mjs --lan",
    "live:off": "node scripts/live-android.mjs --off"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  },
  "browserslist": {
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ]
  }
}
